---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Grain from '../components/Grain.astro';
import GlobalFooter from '../components/GlobalFooter.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  image?: string;
}

const { title, description, pubDate, updatedDate, tags = [], image } = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const primaryTag = (tags[0] ?? 'Notes')
  .replaceAll('-', ' ')
  .replace(/\b\w/g, (character) => character.toUpperCase());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Andrew Allsop</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta property="og:site_name" content="Andrew Allsop" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:author" content="Andrew Allsop" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:site" content="@AndrewAllsop" />
    <meta name="twitter:creator" content="@AndrewAllsop" />
    
    <!-- Canonical -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LNZJEMMDTN"></script>
    <script is:inline define:vars={{ pageTitle: title }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LNZJEMMDTN', {
        page_title: pageTitle,
        page_path: window.location.pathname,
        page_location: window.location.href
      });
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body class="cobalt-inner-page note-page min-h-screen">
    <script is:inline>
      document.documentElement.classList.remove('dark');
    </script>
    <Header variant="cobalt" />

    <main class="cobalt-rail inner-page-rail note-detail-page">
      <header class="inner-masthead article-masthead">
        <div class="inner-masthead-meta">
          <a href="/blog">← All notes</a>
          <span>{primaryTag}</span>
        </div>
        <h1>{title}</h1>
        <p>
          Published <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          {updatedDate && (
            <> · Updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></>
          )}
        </p>
      </header>

      <div class="inner-reading-sheet">
        {image && (
          <figure class="article-figure">
            <img src={image} alt={title} />
          </figure>
        )}

        <article class="note-article">
          <div class="prose article-prose">
            <slot />
          </div>

          <footer class="note-article-footer">
            <a href="/blog">View all notes <span>→</span></a>
          </footer>
        </article>
      </div>
    </main>

    <GlobalFooter />
    <Grain />

  </body>
</html>
