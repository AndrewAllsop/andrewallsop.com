---
const CONTACT_EMAIL = 'andrew@wunderkindagency.com';

// Static build: the form posts client-side to the Cloudflare Worker in
// workers/contact-form/, which relays the message over Resend. Override with
// PUBLIC_CONTACT_ENDPOINT; set it empty to fall back to a mailto: compose.
const DEFAULT_ENDPOINT = 'https://contact-form.andrew-d1a.workers.dev';
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? DEFAULT_ENDPOINT;

const topics = [
  'Growth / demand gen work',
  'Marketing systems review',
  'Speaking or podcast',
  'Something else',
];
---

<section class="contact-form-section" aria-labelledby="contact-form-heading">
  <div id="contact-form-panel">
  <div class="cobalt-section-heading">
    <h2 id="contact-form-heading">Send a message</h2>
  </div>

  <form
    id="contact-form"
    class="contact-form"
    data-endpoint={endpoint}
    data-email={CONTACT_EMAIL}
    novalidate
  >
    <div class="contact-field-row">
      <div class="contact-field">
        <label for="contact-name">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder="Your name"
          aria-describedby="contact-name-error"
        />
        <p class="contact-field-error" id="contact-name-error" hidden></p>
      </div>

      <div class="contact-field">
        <label for="contact-email">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@company.com"
          aria-describedby="contact-email-error"
        />
        <p class="contact-field-error" id="contact-email-error" hidden></p>
      </div>
    </div>

    <div class="contact-field">
      <label for="contact-topic">What's this about?</label>
      <select id="contact-topic" name="topic">
        {topics.map((topic) => <option value={topic}>{topic}</option>)}
      </select>
    </div>

    <div class="contact-field">
      <label for="contact-message">Message</label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        required
        placeholder="A couple of lines on what you're working on and where it's stuck."
        aria-describedby="contact-message-error"></textarea>
      <p class="contact-field-error" id="contact-message-error" hidden></p>
    </div>

    <!-- Spam trap: hidden from people, tempting to bots. -->
    <div class="contact-honeypot" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="contact-actions">
      <button id="contact-submit" type="submit">Send message ↗</button>
      <p>Or email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> directly.</p>
    </div>

    <p class="contact-status" id="contact-status" role="status" aria-live="polite" hidden></p>

    <noscript>
      <p class="contact-status" data-state="error">
        This form needs JavaScript. Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> instead.
      </p>
    </noscript>
  </form>
  </div>

  <!-- Replaces the form once a message actually sends. -->
  <div
    id="contact-success"
    class="contact-success"
    role="status"
    aria-live="polite"
    tabindex="-1"
    hidden
  >
    <p class="contact-success-title">Thanks — your message is on its way.</p>
    <p class="contact-success-detail">I'll reply to the address you gave.</p>
  </div>
</section>

<script>
  type FieldName = 'name' | 'email' | 'message';

  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const validators: Record<FieldName, (value: string) => string | null> = {
    name: (value) => (value.length > 0 ? null : 'Please add your name.'),
    email: (value) => {
      if (value.length === 0) return 'Please add your email address.';
      return EMAIL_PATTERN.test(value) ? null : 'That email address does not look right.';
    },
    message: (value) => {
      if (value.length === 0) return 'Please add a message.';
      return value.length >= 10 ? null : 'A little more detail would help.';
    },
  };

  function showFieldError(field: FieldName, message: string | null) {
    const input = document.getElementById(`contact-${field}`);
    const error = document.getElementById(`contact-${field}-error`);
    if (!(input instanceof HTMLElement) || !(error instanceof HTMLElement)) return;

    error.textContent = message ?? '';
    error.hidden = message === null;
    input.setAttribute('aria-invalid', message === null ? 'false' : 'true');
  }

  function setStatus(element: HTMLElement, state: 'success' | 'error' | null, message: string) {
    element.textContent = message;
    element.hidden = state === null;
    if (state === null) {
      element.removeAttribute('data-state');
    } else {
      element.dataset.state = state;
    }
  }

  /** Hides the form entirely and leaves only the confirmation on screen. */
  function showConfirmation() {
    const panel = document.getElementById('contact-form-panel');
    const success = document.getElementById('contact-success');
    if (!(panel instanceof HTMLElement) || !(success instanceof HTMLElement)) return;

    panel.hidden = true;
    success.hidden = false;
    // Move focus so keyboard and screen reader users land on the message.
    success.focus();
  }

  function buildMailto(email: string, values: Record<string, string>) {
    const subject = `${values.topic || 'Website enquiry'} — ${values.name}`;
    const body = `${values.message}\n\n—\n${values.name}\n${values.email}`;
    return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  }

  function setupContactForm() {
    const form = document.getElementById('contact-form');
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const button = document.getElementById('contact-submit');
    const status = document.getElementById('contact-status');
    if (!(button instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

    const fields: FieldName[] = ['name', 'email', 'message'];

    // Clear a field's error as soon as the person fixes it.
    fields.forEach((field) => {
      const input = document.getElementById(`contact-${field}`);
      if (!(input instanceof HTMLInputElement) && !(input instanceof HTMLTextAreaElement)) return;
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') !== 'true') return;
        if (validators[field](input.value.trim()) === null) showFieldError(field, null);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus(status, null, '');

      const data = new FormData(form);
      const values = Object.fromEntries(
        Array.from(data.entries(), ([key, value]) => [key, String(value).trim()])
      ) as Record<string, string>;

      // Honeypot filled means a bot: pretend it worked, send nothing.
      if (values.website) {
        form.reset();
        showConfirmation();
        return;
      }

      // Surface every problem at once, then send focus to the first one.
      const invalid = fields.filter((field) => {
        const message = validators[field](values[field] ?? '');
        showFieldError(field, message);
        return message !== null;
      });

      if (invalid.length > 0) {
        document.getElementById(`contact-${invalid[0]}`)?.focus();
        setStatus(status, 'error', 'Please fix the highlighted fields and try again.');
        return;
      }

      const endpoint = form.dataset.endpoint ?? '';
      const email = form.dataset.email ?? '';

      // No endpoint configured: hand off to the visitor's email client.
      if (!endpoint) {
        window.location.href = buildMailto(email, values);
        setStatus(status, 'success', 'Opening your email app with the message ready to send.');
        return;
      }

      button.disabled = true;
      button.textContent = 'Sending...';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: values.name,
            email: values.email,
            topic: values.topic,
            message: values.message,
          }),
        });

        if (response.ok) {
          form.reset();
          showConfirmation();
        } else {
          setStatus(status, 'error', `Something went wrong. Please email ${email} instead.`);
        }
      } catch {
        setStatus(status, 'error', `Could not send that. Please email ${email} instead.`);
      } finally {
        button.disabled = false;
        button.textContent = 'Send message ↗';
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:after-swap', setupContactForm);
</script>
