---
import StatusTicker from './StatusTicker.astro';

const currentPath = Astro.url.pathname;

interface Props {
  variant?: 'default' | 'cobalt';
}

const { variant = 'cobalt' } = Astro.props;
const isCobalt = variant === 'cobalt';

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Notes' },
];

const isCurrent = (href: string) => currentPath.startsWith(href);
---

<script is:inline>
  (() => {
    const savedTheme = localStorage.getItem('site-theme');
    document.documentElement.dataset.siteTheme = savedTheme === 'mono' ? 'mono' : 'cobalt';
  })();
</script>

<header class:list={['site-header sticky top-0 z-50 border-b border-black/8 dark:border-white/10', isCobalt && 'site-header-cobalt']}>
  {isCobalt ? (
    <>
      <nav class="cobalt-header-rail" aria-label="Primary navigation">
        <a href="/" class="cobalt-identity" aria-label="Andrew Allsop — Home">
          <img src="/images/andrew-allsop.webp" alt="" width="60" height="60" />
          <span>
            <strong>Andrew Allsop</strong>
            <small>Revenue Growth Engineer</small>
          </span>
        </a>

        <div class="cobalt-header-side">
          <p>Manchester, UK<br /><time data-manchester-time>Local time</time></p>
          <details class="cobalt-nav-menu">
            <summary aria-label="Open navigation">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <div>
              {navLinks.map((link) => <a href={link.href}>{link.label}<span>↗</span></a>)}
              <a href="/contact">Contact<span>↗</span></a>
              <div class="cobalt-theme-control">
                <label for="site-theme-selector">Theme</label>
                <select id="site-theme-selector" aria-label="Site theme">
                  <option value="cobalt">Cobalt</option>
                  <option value="mono">Black / white</option>
                </select>
              </div>
            </div>
          </details>
        </div>
      </nav>
      <div class="cobalt-header-ticker">
        <StatusTicker />
      </div>
    </>
  ) : (
    <nav class="max-w-6xl mx-auto px-6 h-[72px] flex items-center justify-between" aria-label="Primary navigation">
      <a href="/" class="site-wordmark text-xl text-[#202020] dark:text-white" aria-label="Andrew Allsop — Home">
        <span class="sm:hidden">Andrew</span>
        <span class="hidden sm:inline">Andrew Allsop</span>
      </a>

      <div class="flex items-center gap-1 sm:gap-2 text-sm">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 transition-colors',
              isCurrent(link.href)
                ? 'bg-black/[0.06] dark:bg-white/10 text-[#171717] dark:text-white'
                : 'text-[#686862] hover:bg-black/[0.04] hover:text-[#171717] dark:text-neutral-300 dark:hover:bg-white/[0.07] dark:hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href="/contact"
          class="site-contact ml-1 rounded-lg bg-[#202020] px-3.5 py-2 shadow-[0_1px_1px_rgba(0,0,0,.45),inset_0_1px_rgba(255,255,255,.18)] transition-transform hover:-translate-y-px dark:bg-white"
        >
          Contact
        </a>
      </div>
    </nav>
  )}
</header>

{isCobalt && (
  <script>
    const updateManchesterTime = () => {
      const value = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/London',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).format(new Date());
      document.querySelectorAll('[data-manchester-time]').forEach((element) => {
        element.textContent = value;
      });
    };
    updateManchesterTime();
    window.setInterval(updateManchesterTime, 30000);

    const setupSiteThemeSelector = () => {
      const selector = document.getElementById('site-theme-selector');
      if (!(selector instanceof HTMLSelectElement)) return;

      selector.value = document.documentElement.dataset.siteTheme === 'mono' ? 'mono' : 'cobalt';
      if (selector.dataset.bound === 'true') return;

      selector.dataset.bound = 'true';
      selector.addEventListener('change', () => {
        const theme = selector.value === 'mono' ? 'mono' : 'cobalt';
        document.documentElement.dataset.siteTheme = theme;
        localStorage.setItem('site-theme', theme);
      });
    };

    setupSiteThemeSelector();
    document.addEventListener('astro:after-swap', setupSiteThemeSelector);
  </script>
)}
