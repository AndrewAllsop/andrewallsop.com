---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Grain from '../../components/Grain.astro';
import GlobalFooter from '../../components/GlobalFooter.astro';
import GoogleTagManagerHead from '../../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../../components/GoogleTagManagerBody.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    ...post,
    readingTime: Math.max(1, Math.ceil(post.body.trim().split(/\s+/).length / 220)),
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTagManagerHead />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Notes | Andrew Allsop</title>
    <meta name="description" content="Notes on growth, marketing systems, AI, and useful tinkering." />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LNZJEMMDTN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LNZJEMMDTN', {
        page_title: document.title,
        page_path: window.location.pathname,
        page_location: window.location.href
      });
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body class="cobalt-inner-page note-page min-h-screen">
    <GoogleTagManagerBody />
    <script is:inline>
      document.documentElement.classList.remove('dark');
    </script>
    <Header variant="cobalt" />

    <main class="cobalt-rail inner-page-rail note-index">
      <header class="inner-masthead index-masthead">
        <div class="inner-masthead-meta">
          <span>Writing</span>
          <span>{String(sortedPosts.length).padStart(2, '0')} notes</span>
        </div>
        <h1>Notes</h1>
        <p>Thoughts on growth, marketing systems, AI, and useful tinkering.</p>
      </header>

      <section class="notes-directory" aria-labelledby="all-notes-heading">
        <div class="cobalt-section-heading notes-directory-heading">
          <h2 id="all-notes-heading">All notes</h2>
          <span>Newest first · {String(sortedPosts.length).padStart(2, '0')}</span>
        </div>
        <div class="notes-directory-rows">
          {sortedPosts.map((post, index) => (
            <a href={`/blog/${post.id}`} class:list={[post.data.image && 'has-image']}>
              <span class="notes-row-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="notes-row-copy">
                <strong>{post.data.title}</strong>
                <span class="notes-row-description">{post.data.description}</span>
                <span class="notes-row-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
                  </time>
                  <span>{post.readingTime} min read</span>
                  {post.data.tags[0] && <span>{post.data.tags[0].replaceAll('-', ' ')}</span>}
                </span>
              </span>
              {post.data.image && (
                <span class="notes-row-image" aria-hidden="true">
                  <img src={post.data.image} alt="" loading="lazy" />
                </span>
              )}
              <span class="notes-row-action">Read note <b>↗</b></span>
            </a>
          ))}
        </div>
      </section>
    </main>

    <GlobalFooter />
    <Grain />

  </body>
</html>
