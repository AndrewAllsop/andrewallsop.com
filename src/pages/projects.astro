---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Grain from '../components/Grain.astro';
import GlobalFooter from '../components/GlobalFooter.astro';
import GoogleTagManagerHead from '../components/GoogleTagManagerHead.astro';
import GoogleTagManagerBody from '../components/GoogleTagManagerBody.astro';

const projects = [
  {
    title: 'E-Commerce Platform',
    description: 'Full-stack e-commerce with Next.js, Stripe, and PostgreSQL.',
    link: '#',
  },
  {
    title: 'Task Management App',
    description: 'Collaborative task management with real-time updates.',
    link: '#',
  },
  {
    title: 'Portfolio Template',
    description: 'Modern portfolio template built with Astro and Tailwind.',
    link: '#',
  },
  {
    title: 'Weather Dashboard',
    description: 'Weather dashboard with location-based forecasts.',
    link: '#',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTagManagerHead />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Projects | Andrew Allsop</title>
    <meta name="description" content="Projects by Andrew Allsop." />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LNZJEMMDTN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LNZJEMMDTN', {
        page_title: document.title,
        page_path: window.location.pathname,
        page_location: window.location.href
      });
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body class="cobalt-inner-page min-h-screen">
    <GoogleTagManagerBody />
    <script is:inline>
      document.documentElement.classList.remove('dark');
    </script>
    <Header variant="cobalt" />

    <main class="reading-rail inner-content-page px-6 sm:px-10 py-12">

      <!-- Header -->
      <div class="mb-10">
        <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-3">Projects</h1>
        <p class="text-neutral-500 dark:text-neutral-400">A selection of things I've built.</p>
      </div>

      <!-- Projects -->
      <div class="space-y-0">
        {projects.map((project) => (
          <a
            href={project.link}
            class="site-list-link flex items-center justify-between py-4 -mx-3 px-3 group"
          >
            <div>
              <span class="text-neutral-900 dark:text-white block mb-1">{project.title}</span>
              <span class="text-sm text-neutral-500 dark:text-neutral-400">{project.description}</span>
            </div>
            <svg class="w-4 h-4 text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-600 dark:group-hover:text-white transition-colors flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        ))}
      </div>
    </main>

    <GlobalFooter />
    <Grain />
  </body>
</html>
