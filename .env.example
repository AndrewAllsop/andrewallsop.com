# Optional. The contact form defaults to the deployed Cloudflare Worker in
# workers/contact-form/. Override here to point at a different deployment,
# or set it empty to fall back to opening the visitor's email client.
# PUBLIC_CONTACT_ENDPOINT=https://contact-form.andrew-d1a.workers.dev

# Optional. PostHog defaults to the andrewallsop.com project on EU cloud.
# Set the key empty to stop loading PostHog (e.g. in a fork).
# PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
