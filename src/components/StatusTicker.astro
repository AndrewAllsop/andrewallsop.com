---
// Six copies so the strip stays full on the widest rail; the animation moves
// exactly half the track, which keeps the loop seamless.
const COPIES = 6;
const copies = Array.from({ length: COPIES }, (_, index) => index);
---

<section class="cobalt-marquee" aria-label="Currently">
  <span class="cobalt-marquee-label">CURRENTLY</span>
  <div class="cobalt-marquee-window">
    <div class="cobalt-marquee-track">
      {copies.map((index) => (
        <div aria-hidden={index > 0 ? 'true' : undefined}>
          <span><b>Building</b> side projects</span>
          <span><b>Writing</b> about growth & AI</span>
          <span><b>Based</b> in Manchester</span>
        </div>
      ))}
    </div>
  </div>
</section>
