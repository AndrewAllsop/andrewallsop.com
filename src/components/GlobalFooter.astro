<footer class="global-cobalt-footer">
  <section class="global-newsletter" aria-labelledby="global-newsletter-heading">
    <div>
      <h2 id="global-newsletter-heading">Occasional emails</h2>
      <p>Notes on growth, AI and useful tinkering. No noise.</p>
    </div>
    <form id="global-newsletter-form">
      <label for="global-newsletter-email">Email address</label>
      <div>
        <input id="global-newsletter-email" type="email" name="email_address" required placeholder="you@example.com" />
        <button id="global-newsletter-btn" type="submit">Subscribe ↗</button>
      </div>
      <p id="global-newsletter-success" class="hidden">You're in! Check your email to confirm.</p>
      <p id="global-newsletter-error" class="hidden">Something went wrong. Please try again.</p>
    </form>
  </section>

  <div class="global-footer-spacer" aria-hidden="true"></div>

  <div class="global-footer-bottom">
    <a href="/" class="global-footer-name">Andrew Allsop</a>
    <nav aria-label="Social links">
      <a href="https://github.com/AndrewAllsop" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="https://x.com/AndrewAllsop" target="_blank" rel="noopener noreferrer">X ↗</a>
      <a href="https://www.linkedin.com/in/andrewallsop/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </nav>
  </div>
</footer>

<script>
  function setupGlobalNewsletter() {
    const form = document.getElementById('global-newsletter-form');
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;

    form.dataset.bound = 'true';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const emailInput = document.getElementById('global-newsletter-email');
      const button = document.getElementById('global-newsletter-btn');
      const success = document.getElementById('global-newsletter-success');
      const error = document.getElementById('global-newsletter-error');

      if (!(emailInput instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement) || !success || !error) return;

      success.classList.add('hidden');
      error.classList.add('hidden');
      button.disabled = true;
      button.textContent = 'Subscribing...';

      try {
        const response = await fetch('https://api.convertkit.com/v3/forms/9061075/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ api_key: '8YZxYV-nUZS0oKdnQl3x3w', email: emailInput.value }),
        });

        if (response.ok) {
          success.classList.remove('hidden');
          form.reset();
        } else {
          error.classList.remove('hidden');
        }
      } catch {
        error.classList.remove('hidden');
      } finally {
        button.disabled = false;
        button.textContent = 'Subscribe ↗';
      }
    });
  }

  setupGlobalNewsletter();
  document.addEventListener('astro:after-swap', setupGlobalNewsletter);
</script>
