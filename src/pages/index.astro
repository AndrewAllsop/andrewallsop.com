---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Grain from '../components/Grain.astro';
import GlobalFooter from '../components/GlobalFooter.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const workItems = [
  { title: 'Roledge', detail: 'AI sales enablement', href: 'https://roledge.com', action: 'View site' },
  { title: 'Wunderkind', detail: 'Revenue growth systems', href: 'mailto:andrew@wunderkindagency.com', action: 'Get in touch' },
  { title: 'Open-source tinkering', detail: 'Tools & experiments', href: 'https://github.com/AndrewAllsop', action: 'View GitHub' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Andrew Allsop</title>
    <meta name="description" content="Revenue Growth Engineer helping B2B SaaS companies connect marketing to financial outcomes." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LNZJEMMDTN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LNZJEMMDTN', {
        page_title: document.title,
        page_path: window.location.pathname,
        page_location: window.location.href
      });
    </script>
  </head>
  <body class="cobalt-page">
    <Header variant="cobalt" />

    <main class="cobalt-rail">
      <div class="cobalt-content">
        <section class="cobalt-intro" aria-label="Introduction">
          <p>I'm a Demand Generation Expert helping tech companies maximise their growth without jeopardising their financial position.</p>
          <p>I work across marketing, analytics and commercial strategy—connecting channel performance to the downstream numbers that actually determine whether growth is sustainable.</p>
          <p>Right now I'm building <a href="https://roledge.com" target="_blank" rel="noopener noreferrer">Roledge</a>, writing about systems and growth, and tinkering with AI until it earns its keep.</p>
        </section>

        <section class="cobalt-section" aria-labelledby="work-heading">
          <div class="cobalt-section-heading">
            <h2 id="work-heading">Selected work</h2>
            <span>03</span>
          </div>
          <div class="cobalt-rows">
            {workItems.map((item) => (
              <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                <span class="cobalt-row-main">
                  <strong>{item.title}</strong>
                  <small>{item.detail}</small>
                </span>
                <span class="cobalt-row-action">{item.action} ↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="cobalt-section" aria-labelledby="notes-heading">
          <div class="cobalt-section-heading">
            <h2 id="notes-heading">Latest notes</h2>
            <a href="/blog">View all ↗</a>
          </div>
          <div class="cobalt-rows cobalt-note-rows">
            {recentPosts.map((post) => (
              <a href={`/blog/${post.id}`}>
                <span class="cobalt-row-main">
                  <strong>{post.data.title}</strong>
                  <small>{post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</small>
                </span>
                <span class="cobalt-row-action">Read note ↗</span>
              </a>
            ))}
          </div>
        </section>

      </div>
    </main>

    <GlobalFooter />
    <Grain />
  </body>
</html>
